# Local dev override — Vite loads this with higher precedence than .env,
# without editing the committed production config. Points the dev server's
# /api proxy at the local backend instead of https://req-api.evyoog.com.
# Delete this file (or make sure it's gitignored) before committing if you
# don't want it tracked.
VITE_API_PROXY_TARGET=http://localhost:8083
