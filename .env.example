# Copy to .env (gitignored) and fill in. Every value below is a FAKE placeholder for a
# LOCAL setup. Never commit a real credential (D22). run-local.sh and `docker compose`
# both read this file; deployed environments set the same names from the secrets manager.

# --- Required: the app refuses to start if any of these six is empty --------------------
# Local docker-compose Postgres (docker compose reads DB_PASSWORD as the database's password).
DB_URL=jdbc:postgresql://localhost:5432/vygmicroservice?currentSchema=vyg_requirement,public
DB_USER=postgres
DB_PASSWORD=local-dev-db-password-not-a-real-one

# Keycloak confidential clients. Real values come from a Keycloak administrator.
# vyg-devops-ui: server-side username/password sign-in (D21).
KEYCLOAK_ROPC_CLIENT_SECRET=replace-me-vyg-devops-ui-client-secret
# eVyoog: impersonation broker for cross-app SSO.
KEYCLOAK_IMPERSONATION_CLIENT_SECRET=replace-me-evyoog-client-secret
# Must equal the value configured on every other app's backend in the SSO mesh.
INTERNAL_SSO_SHARED_SECRET=replace-me-shared-sso-secret

# --- CORS allowlist (no wildcard is accepted) --------------------------------------------
# Exact origins, comma-separated. Default: https://devops.evyoog.com
# CORS_ALLOWED_ORIGINS=https://devops.evyoog.com
# Local-dev hosts on any port. Empty by default; needed for `npm run dev` on localhost.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
# Reaching the Vite dev server from another device on your LAN (optional):
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*

# --- One-time bootstrap (leave unset except when creating the very first administrator) ---
# POST /api/v1/settings/bootstrap is refused unless this is set, the request carries it as
# the X-Bootstrap-Token header, and no administrator exists yet. Unset it again afterwards.
# BOOTSTRAP_TOKEN=

# --- Token audience (recommended once Keycloak issues it; see docs/08-architecture/security/audience.md) ---
# The audience every access token must carry. Empty = not checked (a startup warning says so).
# JWT_AUDIENCE=vyoog-api

# --- Optional -----------------------------------------------------------------------------
# ATTACHMENT_MAX_BYTES=10485760   # largest upload (10 MiB); multipart limits in application.yml match
# AUTH_COOKIE_SECURE=false        # only for plain-HTTP dev on a non-localhost host
# AI_ENABLED=true
# AI_API_KEY=                      # OpenAI key; AI features report themselves unconfigured without it
# Keycloak endpoints default to the shared eVyoog realm and are not secrets:
# KEYCLOAK_ISSUER, KEYCLOAK_JWKS, KEYCLOAK_TOKEN_URI, KEYCLOAK_END_SESSION_URI,
# KEYCLOAK_ROPC_CLIENT_ID (vyg-devops-ui), KEYCLOAK_IMPERSONATION_CLIENT_ID (eVyoog)
