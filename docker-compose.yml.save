
# 2. Start PostgreSQL
docker compose up -d postgres

# 3. Check
docker compose psservices:
  # Local Postgres for fast dev iteration, shaped like the shared RDS instance
  # (same db name, same schema). The password comes from DB_PASSWORD in .env
  # (copy .env.example to .env); compose refuses to start without it. Use the same
  # value for the app's DB_PASSWORD. This database is local-only.
  postgres:
    image: pgvector/pgvector:pg16
    container_name: vyoog-db
    environment:
      POSTGRES_DB: sandbox
      POSTGRES_USER: sandboxadmin
      POSTGRES_PASSWORD: ${DB_PASSWORD:?set DB_PASSWORD in .env (copy .env.example)}
    ports: ["5433:5432"]
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./database/init:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d sandbox"]
      interval: 5s
      timeout: 5s
      retries: 10

  # No local Keycloak. Vyoog authenticates against the company's real, shared
  # Keycloak realm (eVyoog at https://user.evyoog.com) — same as vyg-pms and the
  # pricing tool. See docs/DECISIONS.md D3 and docs/archive/vyoog-getting-started.md for
  # what needs registering there before sign-in works end to end.

  redis:
    image: redis:7-alpine
    container_name: vyoog-redis
    ports: ["6379:6379"]

  minio:
    image: quay.io/minio/minio
    container_name: vyoog-minio
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: minio
      MINIO_ROOT_PASSWORD: minio123
    ports: ["9000:9000", "9001:9001"]
    volumes: [miniodata:/data]

volumes:
  pgdata:
  miniodata:
